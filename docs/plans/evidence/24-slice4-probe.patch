# DIAGNOSTIC ONLY: this returns an uninitialized RuntimeModule and pretends every type is Int32.
# Apply to the slice-4 baseline only to reproduce the measurements; do not ship it.
#
# cargo build -p dotnet-cli
# bash scripts/diff_run.sh crates/dotnet-cli/tests/debug_fixtures/dynamic_method_add_42.cs
# bash scripts/diff_run.sh crates/dotnet-cli/tests/debug_fixtures/dynamic_method_call_42.cs
# bash scripts/diff_run.sh crates/dotnet-cli/tests/debug_fixtures/dynamic_method_catch_42.cs
#
# For the intermediate GetNativeTypeHandle failure, omit spike_int32_element_type.
# DOTNET_RS_TRACE=stderr DOTNET_RS_TRACE_LEVEL=trace and a suitable
# DOTNET_RS_TRACE_METHODS filter show the method entries.
diff --git a/crates/dotnet-vm/src/intrinsics/linq_expressions.rs b/crates/dotnet-vm/src/intrinsics/linq_expressions.rs
--- a/crates/dotnet-vm/src/intrinsics/linq_expressions.rs
+++ b/crates/dotnet-vm/src/intrinsics/linq_expressions.rs
@@ -8,4 +8,29 @@ use dotnet_types::{
 };
 use dotnetdll::prelude::MethodMemberIndex;
 
+#[dotnet_intrinsic("static System.Reflection.Module System.Reflection.Emit.DynamicMethod::GetDynamicMethodsModule()")]
+pub fn spike_fake_module<'gc, T: TypedStackOps<'gc> + VmLoaderOps + crate::stack::ops::MemoryOps<'gc>>(
+    ctx: &mut T,
+    _method: MethodDescription,
+    _generics: &GenericLookup,
+) -> StepResult {
+    let ty = dotnet_vm_ops::vm_try!(ctx.loader().corlib_type("System.Reflection.RuntimeModule"));
+    let obj = dotnet_vm_ops::vm_try!(ctx.new_object(ty));
+    let gc = ctx.gc_with_token(&ctx.no_active_borrows_token());
+    let obj = ctx.alloc_obj_ref(gc, obj);
+    ctx.push_obj(obj);
+    StepResult::Continue
+}
+
+#[dotnet_intrinsic("System.Reflection.CorElementType System.RuntimeType::GetCorElementType()")]
+pub fn spike_int32_element_type<'gc, T: TypedStackOps<'gc>>(
+    ctx: &mut T,
+    _method: MethodDescription,
+    _generics: &GenericLookup,
+) -> StepResult {
+    let _ = ctx.pop_obj();
+    ctx.push_i32(8);
+    StepResult::Continue
+}
+
